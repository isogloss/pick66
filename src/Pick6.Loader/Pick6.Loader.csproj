<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>loader</AssemblyName>
  </PropertyGroup>
  
  <!-- Single-file publishing settings for Windows x64 -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Optimize for self-contained deployment -->
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- NuGet packages for embedding dependencies -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\Pick6.Core\Pick6.Core.csproj" />
    <ProjectReference Include="..\Pick6.Projection\Pick6.Projection.csproj" />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Monocraft.ttf" />
  </ItemGroup>

  <!-- Native DLLs that must be extracted alongside the executable for injection -->
  <!-- These DLLs cannot be bundled into the single-file package because they need -->
  <!-- to be accessible for DLL injection into other processes -->
  <ItemGroup>
    <!-- Core hook DLL - REQUIRED for application to work -->
    <Content Include="Pick6VulkanHook.dll" Condition="Exists('Pick6VulkanHook.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    
    <!-- Native injector DLL - optional but recommended -->
    <Content Include="Pick6Native.dll" Condition="Exists('Pick6Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    
    <!-- Proxy DLLs - optional, for alternative injection strategies -->
    <Content Include="dxgi.dll" Condition="Exists('dxgi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="d3d11.dll" Condition="Exists('d3d11.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="vulkan-1.dll" Condition="Exists('vulkan-1.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    
    <!-- Alternative naming convention for proxy DLLs -->
    <Content Include="Pick6DxgiProxy.dll" Condition="Exists('Pick6DxgiProxy.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Pick6D3d11Proxy.dll" Condition="Exists('Pick6D3d11Proxy.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Pick6VulkanProxy.dll" Condition="Exists('Pick6VulkanProxy.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>