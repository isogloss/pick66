<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>pick6</AssemblyName>
  </PropertyGroup>
  
  <!-- Single-file publishing settings for Windows x64 -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Optimize for self-contained deployment -->
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- NuGet packages for embedding dependencies -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\Pick6.Core\Pick6.Core.csproj" />
    <ProjectReference Include="..\Pick6.Projection\Pick6.Projection.csproj" />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Monocraft.ttf" />
  </ItemGroup>

  <!-- Native DLLs that must be embedded as resources for single-file distribution -->
  <!-- These DLLs are extracted at runtime to enable DLL injection into other processes -->
  <ItemGroup>
    <!-- Core hook DLL - REQUIRED for application to work -->
    <EmbeddedResource Include="Pick6VulkanHook.dll" Condition="Exists('Pick6VulkanHook.dll')">
      <LogicalName>Pick6VulkanHook.dll</LogicalName>
    </EmbeddedResource>
    
    <!-- Native injector DLL - optional but recommended -->
    <EmbeddedResource Include="Pick6Native.dll" Condition="Exists('Pick6Native.dll')">
      <LogicalName>Pick6Native.dll</LogicalName>
    </EmbeddedResource>
    
    <!-- Proxy DLLs - optional, for alternative injection strategies -->
    <EmbeddedResource Include="dxgi.dll" Condition="Exists('dxgi.dll')">
      <LogicalName>dxgi.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="d3d11.dll" Condition="Exists('d3d11.dll')">
      <LogicalName>d3d11.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vulkan-1.dll" Condition="Exists('vulkan-1.dll')">
      <LogicalName>vulkan-1.dll</LogicalName>
    </EmbeddedResource>
    
    <!-- Alternative naming convention for proxy DLLs -->
    <EmbeddedResource Include="Pick6DxgiProxy.dll" Condition="Exists('Pick6DxgiProxy.dll')">
      <LogicalName>Pick6DxgiProxy.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Pick6D3d11Proxy.dll" Condition="Exists('Pick6D3d11Proxy.dll')">
      <LogicalName>Pick6D3d11Proxy.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Pick6VulkanProxy.dll" Condition="Exists('Pick6VulkanProxy.dll')">
      <LogicalName>Pick6VulkanProxy.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>